{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.ts mcp/*.test.ts",
    "scan": "node --experimental-strip-types demo.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "mcp": "node --experimental-strip-types mcp/server.ts",
    "verify:setup": "node scripts/verify-setup.mjs",
    "agent:install": "node scripts/install-agent.mjs",
    "monitor:enable": "node scripts/manage-monitor.mjs enable",
    "monitor:pause": "node scripts/manage-monitor.mjs pause",
    "mcp:smoke": "node scripts/smoke-local.mjs"
  },
  "engines": {
    "node": ">=22.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-cost-explorer": "^3.1141.0",
    "@aws-sdk/client-ec2": "^3.1141.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1141.0",
    "@aws-sdk/client-sts": "^3.1141.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@truefoundry/trueforge-sdk": "^0.2.0",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
