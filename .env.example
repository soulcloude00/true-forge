# Optional named AWS CLI profile; leave unset to use the normal AWS credential chain.
AWS_PROFILE=
AWS_REGION=us-east-1

# Local TrueForge and Nimbus MCP endpoints.
TRUEFORGE_BASE_URL=http://localhost:8790
NIMBUS_MCP_PORT=8792
NIMBUS_MCP_URL=http://127.0.0.1:8792/mcp

# Optional local baseline path; defaults to ~/.nimbus-cost-agent/cost-baselines.json.
NIMBUS_COST_BASELINE_FILE=

# Destructive demo tool is disabled by default. Only set these for one dedicated,
# encrypted 1 GiB gp3 volume tagged for the Agents That Act disposable demo.
NIMBUS_ENABLE_DISPOSABLE_VOLUME_DELETE=false
NIMBUS_DISPOSABLE_VOLUME_ACCOUNT_ID=
NIMBUS_DISPOSABLE_VOLUME_REGION=
NIMBUS_DISPOSABLE_VOLUME_ID=
